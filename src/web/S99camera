#!/bin/sh
# S99camera — 摄像头显示系统开机自启
# 1. 释放显示设备 (杀 weston)
# 2. 启动 Web 管理后台 (Rust 版, 自动恢复上次连接的摄像头)
# 3. 看门狗: 管线/后台进程挂了自动拉起

WEB_PORT=8090

start_web() {
    # 先杀旧进程释放端口 (看门狗/部署可能留了僵尸实例)
    killall -9 rv1126_web 2>/dev/null
    sleep 1
    /root/rv1126_web >/tmp/web.log 2>&1 &
}

case "$1" in
start)
    echo "Starting camera display system..."

    # 释放 /dev/fb0
    killall weston 2>/dev/null

    # 等 weston 完全退出 (最多 5 秒)
    # 关键: weston 退出时会写 bl_power=4 关背光,
    # 如果先写 0 再等, weston 退出后会把 0 覆盖成 4 → 黑屏
    for i in 1 2 3 4 5; do
        pidof weston >/dev/null 2>&1 || break
        sleep 1
    done

    # weston 已退出, 现在开背光不会被覆盖
    echo 0 > /sys/class/backlight/backlight/bl_power 2>/dev/null

    # 激活 CRTC (显示控制器): 杀 weston 会释放 CRTC, 不重新激活则屏幕黑屏
    # 一旦激活即保持, 后续管线重启不影响
    modetest -M rockchip -s 96@73:720x1280 >/tmp/modetest.log 2>&1 &
    sleep 1

    # 启动 Web 管理后台 (Rust 版; 它会自动恢复上次连接)
    if ! ss -tlnp 2>/dev/null | grep -q ":$WEB_PORT"; then
        start_web
        echo "  Web 后台已启动 (Rust 版, http://<板子IP>:$WEB_PORT)"
    else
        echo "  Web 后台已在运行 (端口 $WEB_PORT)"
    fi

    # 看门狗: 每 15 秒检查, 掉了就拉起
    ( while true; do
        sleep 15
        # Web 后台掉了 (按端口检查, 避免 pidof 误判僵尸进程)
        ss -tlnp 2>/dev/null | grep -q ":$WEB_PORT" || start_web
        # 管线掉了且有已保存的连接 → 重启 web 触发自动恢复
        pidof rtsp_display >/dev/null 2>&1 || {
            [ -f /root/last_connect.json ] && {
                start_web
            }
        }
    done ) &
    echo "  看门狗已启动"

    # producer (板子当摄像头) 看门狗: MPP 编码器偶发被饿死崩溃, 崩了自动重启
    # (脚本: producer_watchdog.sh — 处理 :80 被 nginx 占用 + 端口释放竞态)
    /root/producer_watchdog.sh >/dev/null 2>&1 &
    echo "  producer 看门狗已启动"
    ;;
stop)
    killall -9 rv1126_web 2>/dev/null
    for p in $(pidof rtsp_display); do kill -9 $p 2>/dev/null; done
    echo "Stopped."
    ;;
*)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
